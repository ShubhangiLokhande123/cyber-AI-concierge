# ── Tavus ──────────────────────────────────────────────────────────────────
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_REPLICA_ID=your_replica_id_here
TAVUS_PERSONA_ID=your_persona_id_here
# Your publicly reachable backend URL (use ngrok in development)
WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ── Groq (free — get key at console.groq.com) ──────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tavily (web search — free at tavily.com) ────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── ElevenLabs TTS (configured on Tavus persona) ────────────────────────────
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ── App ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_HOST=0.0.0.0
APP_PORT=8000

